  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Pelin peruss\xE4\xE4nn\xF6t\n\n\n\nPeli alkaa niin, ett\xE4 yksi pelaajista
    jakaa kaikille seitsem\xE4n korttia, ja asettaa loppupakan v\xE4\xE4rinp\xE4in
    p\xF6yd\xE4lle ja nostaa sitten yhden korttin aloituskortiksi oikeinp\xE4in.
    Aloituskortti ei voi olla erikoiskortti. P\xE4\xE4t\xE4tte pelaajan, joka aloittaa
    ja suunnan mihin peli kulkee. Pelaajan tulee asettaa p\xF6yd\xE4lle kortti, joka
    on joko samaa v\xE4ri\xE4, sama numero tai samaa kuvaa kuin p\xF6yd\xE4ll\xE4
    oleva. My\xF6s mustat jokerikortit k\xE4yv\xE4t.\n\n\n\nPeli jatkuu niin kauan,
    kunnes jollakin pelaajalla on vain yksi kortti j\xE4ljell\xE4. T\xE4ll\xF6in
    h\xE4nen tulee muistaa huutaa sana \u201DOnu\u201D. Jos h\xE4n unohtaa, joutuu
    h\xE4n nostamaan kaksi korttia lis\xE4\xE4, mik\xE4li joku pelaajista huomauttaa
    asiasta. Ensimm\xE4isen\xE4 k\xE4den tyhj\xE4ksi saanut voittaa. Et voi lopettaa
    erikoiskortteihin ja voit laittaa useamman \u201Dperus\u201D korttin lopettaaksesi
    pelin, esimerkiksi kolme eri v\xE4rist\xE4 vitosta yhdell\xE4 kerralla, jos p\xF6yd\xE4ll\xE4
    on se sama numero viisi tai jokin niist\xE4 kolmesta v\xE4rist\xE4 mit\xE4 sinulla
    on.\n\n\n\nHaasto\n\n\n\nKeltainen kortti=nopeus haaste\nPunainen kortti=fyysinen
    haaste\nSininen kortti=tieto haaste\nVihre\xE4 haaste=tuuri haaste\n\n\n\nHaastaminen
    k\xE4yt\xE4nn\xF6ss\xE4 tarkoittaa, ett\xE4 otat erillisest\xE4 pakasta saman
    v\xE4risen haastokortin, kun p\xF6yd\xE4ll\xE4 oleva erikoiskortti. Sinun ei
    ole pakko haastaa, jos et halua. Haastaminen tuo peliin pienen twistin, joka
    tekee pelist\xE4 hauskemman ja mielenkiintoisemman.\n\n\n\nErikoiskortit\n\n\n\nNosta
    2 -erikoiskortin saa pelata, jos p\xF6yd\xE4ll\xE4 oleva kortti on samaa v\xE4ri\xE4
    kuin korttisi tai sama kortti eli nosta 2. N\xE4it\xE4 voi my\xF6s halutessaan
    pelata kerralla niin monta kuin niit\xE4 omistaa. Kun kortti ly\xF6d\xE4\xE4n
    p\xF6yt\xE4\xE4n, seuraava pelaaja joutuu nostamaan pakasta kaksi korttia. T\xE4m\xE4n
    j\xE4lkeen vuoro siirtyy seuraavalle. Poikkeuksena on tilanne, jossa my\xF6s
    seuraavalla pelaajalla on Nosta 2 -kortti. Silloin h\xE4n voi laittaa sen pinon
    p\xE4\xE4llimm\xE4iseksi ja v\xE4ltty\xE4 nostamasta kortteja. Sen sijaan seuraava
    pelaaja joutuu nostamaan nelj\xE4 korttia. Ketjutusta voidaan jatkaa, kunnes
    kenell\xE4k\xE4\xE4n ei ole Nosta 2 -kortteja j\xE4ljell\xE4. Jos haastat kortin,
    joudut nostamaan kaksinkertaisen m\xE4\xE4r\xE4n kortteja jos h\xE4vi\xE4t haaston.
    Jos kortteja on laitettu useampi p\xE4\xE4llekk\xE4in ja haastat niin sinun pit\xE4\xE4
    haastaa jokainen laitettu kortti erikseen. esim. jos p\xF6yd\xE4lle on laitettu
    kaksi +2 korttia joudut haastamaan ne erikseen ja tehd\xE4 2 haastetta kortin
    v\xE4rien mukaan. Sinun ei ole pakko haastaa molempia kortteja voit haastaa vain
    yhden, jos haluat. Jos h\xE4vi\xE4t haaston, joudut nostamaan +4. Jos voitat
    haaston, et joudu nostamaan yht\xE4\xE4n korttia.\n\nToinen kuva\n\nNosta +4
    -kortin puolestaan saa my\xF6s pelata milloin vain mink\xE4 vain kortin p\xE4\xE4lle.
    Silloin seuraava pelaaja joutuu nostamaan nelj\xE4 korttia, ja kortin esitt\xE4nyt
    saa lis\xE4ksi p\xE4\xE4tt\xE4\xE4, milt\xE4 v\xE4rilt\xE4 peli\xE4 jatketaan.
    Kortin laittaja joutuu p\xE4\xE4tt\xE4m\xE4\xE4n v\xE4rin ennen, kuin toinen
    pelaaja haastaa minipeliin. Kortteja voi pelata useita kerralla, mutta v\xE4rimuutoksia
    saa siit\xE4 huolimatta esitt\xE4\xE4 vain yhden. Mik\xE4li seuraavalla pelaajalla
    on my\xF6s Nosta +4 -kortti, h\xE4n voi pelata sen, jolloin vuoro siirtyy seuraavalle,
    joka joutuu nostamaan kahdeksan korttia. Vain pelaaja jolle kortti on tullut
    voi haastaa kortin. T\xE4m\xE4n kortin haaste toimii samallailla kun +2, mutta
    muista ett\xE4 kortin laittajan pit\xE4\xE4 p\xE4\xE4tt\xE4\xE4 v\xE4ri, ennen
    kuin toinen voi haastaa.\n\n\n\nSuunnanvaihto -kortin saa pelata Nosta 2 -kortin
    tapaan, kun se sopii peliin arvonsa tai v\xE4rins\xE4 puolesta. Kortti muuttaa
    nimens\xE4 mukaisesti pelisuunnan, ja kortteja voi halutessaan pelata kerralla
    useampia. Jos pelaaja k\xE4ytt\xE4\xE4 parillisen m\xE4\xE4r\xE4n Suunnanvaihto-kortteja,
    pelisuunta ei muutu. Parittomalla m\xE4\xE4r\xE4ll\xE4 se muuttuu. Kuka tahansa
    pelaaja voi haastaa t\xE4m\xE4n kortin, jos haluaa vaikka ei olisikaan h\xE4nen
    vuoro. Jos haastaja h\xE4vi\xE4\xE4 haaston niin suunnanvaihto toteutuu ja haastajan
    seuraava vuoro j\xE4\xE4 v\xE4list\xE4. Jos haastaja voittaa niin suunnanvaihtoa
    ei tapahdu.\n\n\n\nSkippaus -kortin avulla vuoro siirtyy seuraavan pelaajan ohi.
    Jos kortteja k\xE4ytt\xE4\xE4 kerralla useita, vuoro siirtyy niin monen pelaajan
    ohi kuin kortteja on. Jos haastat kortin ja h\xE4vi\xE4t niin menet\xE4t my\xF6s
    seuraavan kierroksen vuorosi, jos voittaa haaston niin skippi ei toteudu. Jos
    aikaisempi pelaaja laittoi kaksi skip korttia ja haastat, voit vain haastaa skippaus
    kortin joka osuu kohdallesi.\n\n\n\nV\xE4rinvaihto -kortin saa v\xE4rist\xE4
    riippumatta pelata kuka vain ja mink\xE4 tahansa kortin p\xE4\xE4lle. T\xE4ll\xF6in
    pelaaja saa p\xE4\xE4tt\xE4\xE4, mit\xE4 v\xE4ri\xE4 seuraavana vuorossa olevan
    pelaajan pit\xE4\xE4 pelata. Kortteja voi halutessaan pelata kerralla useita,
    mutta silloinkin voi esitt\xE4\xE4 ainoastaan yhden v\xE4rimuutoksen. Samalla
    kertaa ei saa pelata muita kortteja. T\xE4ss\xE4kin kortissa kuka tahansa voi
    haastaa kortin, kun se laitetaan. Jos haastaja voittaa h\xE4n saa p\xE4\xE4tt\xE4\xE4
    v\xE4rin. Jos haastaja h\xE4vi\xE4\xE4 niin haastajan pit\xE4\xE4 nostaa kortin
    laittajan valitseman v\xE4rin kunnes se tulee pakasta. Huom, kortin laittajan
    pit\xE4\xE4 valita v\xE4ri ennen kuin toinen pelaaja voi haastaa!"
  m_isRightToLeft: 0
